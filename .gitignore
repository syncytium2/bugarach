__pycache__/
*.pyc
.venv/
venv/
dist/
build/
*.egg-info/
.pytest_cache/
.DS_Store
# Claude Code writes interactive "always allow" rules here; the shared
# baseline is the tracked .claude/settings.json (see docs/session_protocol.md)
.claude/settings.local.json

# generated by tools/build_site.py (upload artifact, not source).
# ANCHORED, and it matters: unanchored, `site/` matches a directory of that
# name at ANY depth, so `docs/site/` — the hand-written page the build copies
# FROM — was silently untracked. `git status` showed nothing, the commit looked
# complete, and a fresh clone would fail the build with no clue why.
/site/

# node is here only to run wrangler (see docs/deploy.md)
node_modules/

# wrangler's local state. It caches the logged-in Cloudflare account — the account
# id and its display name, which is a person's email address — into a file that is
# trivially caught by `git add -A`, and this repo is public. Nothing in it is a
# credential and nothing in it is needed to deploy: wrangler rewrites it at the next
# login. It was tracked for a day before anyone looked.
.wrangler/

# figure tools write an interactive .html beside each .png; only the PNG is
# a documentation artifact, the HTML is regenerable build output
docs/generator/*.html

# regenerable intermediate for the MATLAB reference generator (prep_ref_input.py)
tools/matlab_ref/ref_input_*.mat
