{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash tools/session_briefing.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/session-start.sh",
            "timeout": 45
          }
        ]
      },
      {
        "matcher": "resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash tools/session_briefing.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/session-start.sh",
            "timeout": 45
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "SendMessage",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/require-commit-before-message.sh",
            "timeout": 10,
            "statusMessage": "Checking the work is committed before messaging…"
          }
        ]
      }
    ]
  }
}
