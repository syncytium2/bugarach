{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash tools/session_briefing.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash tools/session_start_trimmed.sh",
            "timeout": 45
          },
          {
            "type": "command",
            "command": "bash tools/cloud_python.sh",
            "timeout": 120
          }
        ]
      },
      {
        "matcher": "resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash tools/session_briefing.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash tools/session_start_trimmed.sh",
            "timeout": 45
          },
          {
            "type": "command",
            "command": "bash tools/cloud_python.sh",
            "timeout": 120
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "SendMessage",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/require-commit-before-message.sh",
            "timeout": 10,
            "statusMessage": "Checking the work is committed before messaging\u2026"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/no-heredoc-source.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/the-folder-is-the-input.sh",
            "timeout": 10,
            "statusMessage": "Checking this reads the export folder, not a store…"
          },
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/tools/adr/adr.py\"; [ -f \"$f\" ] && exec python3 -X utf8 \"$f\" hook || exit 0",
            "timeout": 120,
            "statusMessage": "Checking the decision records before this git command…"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "SendUserFile",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/send-goes-nowhere.py",
            "timeout": 10,
            "statusMessage": "That file may have reached nobody…"
          }
        ]
      }
    ]
  }
}
