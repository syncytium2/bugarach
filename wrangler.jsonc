{
  // Cloudflare Workers config — assets-only, same shape as colonel_kernel's:
  // no server script, Cloudflare just serves ./site directly.
  //
  // Nothing here runs Python. The site is a static build produced by
  // `python tools/build_site.py`, so there is no server to keep warm, nothing
  // to sleep, and no per-request cost. The interactive viewer (`bugarach view`)
  // still needs a local Python process — see docs/deploy.md for why, and what
  // it would take to put it in the browser instead.
  //
  // DATA POSTURE, load-bearing: only SYNTHETIC data is ever built into this
  // site. FOUNDATIONS §5 keeps real stores machine-local behind
  // BUGARACH_DATA_ROOT, and this repo and this site are public. The build
  // script generates its own data from a seed; it reads no store.
  "name": "bugarach",
  "compatibility_date": "2026-07-01",
  "workers_dev": true,
  "preview_urls": true,

  // The custom domain, declared rather than clicked. On `wrangler deploy`
  // Cloudflare creates the DNS record and the Worker binding for this hostname
  // itself — there is nothing to do in the dashboard, and nothing to do at
  // Porkbun, which is only the registrar (tonydefazio.com's nameservers already
  // delegate to Cloudflare: arya/clyde.ns.cloudflare.com).
  //
  // Declaring it here rather than in the UI means the hostname is in version
  // control with everything else, and a fresh clone deploys to the same place
  // instead of to a workers.dev URL somebody has to go and re-point by hand.
  "routes": [
    { "pattern": "bugarach.tonydefazio.com", "custom_domain": true }
  ],

  "assets": {
    "directory": "./site"
  }
}
